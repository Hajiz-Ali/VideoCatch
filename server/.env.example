# ------------------------------------------------------------------
# Universal Video Downloader — server configuration
# Copy this file to ".env" and adjust values. Never commit ".env".
# ------------------------------------------------------------------

# --- HTTP server ---------------------------------------------------
PORT=8787
HOST=0.0.0.0

# --- Media extraction binaries --------------------------------------
# Leave blank to auto-discover "yt-dlp" / "ffmpeg" on PATH (and .exe).
# YT_DLP_BINARY=yt-dlp
# FFMPEG_BINARY=ffmpeg

# Optional cookiefile (Netscape format) used for extractors that need
# an authorised session (e.g. private links the admin has already been
# granted access to). Leave empty to disable. NEVER add unauthorised
# cookies or bypass DRM/paywalls.
# YT_DLP_COOKIES_FILE=

# Optional extra yt-dlp CLI args appended verbatim to every invocation
# (admin-controlled only; not user input). e.g.:
# YT_DLP_EXTRA_ARGS=--no-cache-dir --socket-timeout 30

# --- Supported sources / SSRF guards --------------------------------
# Comma-separated allowlist of extraction hostnames/domains.
# Subdomains are allowed automatically. Defaults to the built-in list.
# ALLOWED_DOMAINS=tiktok.com,youtube.com

# Set to true to allow ANY public hostname (private/loopback IPs are
# ALWAYS blocked regardless). Use only if you know what you are doing.
# ALLOW_ALL_HOSTS=false

# --- Job / concurrency limits ---------------------------------------
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_ANALYZES=3
MAX_QUEUE_LENGTH=100
MAX_URL_LENGTH=2048

# Rate limiting (requests per minute per IP)
ANALYZE_RATE_LIMIT=20
DOWNLOAD_RATE_LIMIT=10
POD_PROGRESS_RATE_LIMIT=60

# --- Downloaded-file limits -----------------------------------------
# Skip / reject any single stream larger than this many bytes.
# 0 = no per-stream cap (still capped below by MAX_DOWNLOAD_SIZE_BYTES).
MAX_FORMAT_SIZE_BYTES=4294967296
# Hard cap for the final merged file size in bytes (0 = unlimited).
MAX_DOWNLOAD_SIZE_BYTES=0

# --- Timeouts (ms) --------------------------------------------------
ANALYZE_TIMEOUT_MS=90000
DOWNLOAD_TIMEOUT_MS=1800000
JOB_TTL_MS=3600000
FILE_TTL_MS=3600000
CLEANUP_INTERVAL_MS=300000
ANALYZE_CACHE_TTL_MS=1800000

# --- Storage ---------------------------------------------------------
# Where completed downloads + transient job work directories live.
# DATA_DIR=./data

# --- Frontend ---------------------------------------------------------
# Serve the static frontend (the project root index.html) from the API.
SERVE_FRONTEND=true
# FRONTEND_DIR=../

# --- Logging -----------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
LOG_FILE=